<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Account Center - HappyStore</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bangers&family=Figtree:ital,wght@0,300..900;1,300..900&family=Hachi+Maru+Pop&family=Manrope:wght@200..800&family=Metrophobic&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Questrial&family=Raleway:ital,wght@0,100..900;1,100..900&family=Red+Hat+Display:ital,wght@0,300..900;1,300..900&family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/index.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@4.7.0/fonts/remixicon.css"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <div class="flex-grow">

    
    <nav class="flex justify-between lg:justify-between justify-center px-7 py-2 mb-0 lg:mb-7">
      <div class="logoPart">
        <img
          src="/images/ecom-logo.png"
          class="max-w-full h-auto"
          width="180"
        />
      </div>

      <div class="hidden lg:flex items-center gap-4">
        <a href="/" class="hover:text-red-500">Products</a>
        <a href="/cart" class="hover:text-red-500">Cart</a>
        <a href="/user/account" class="text-red-500">My Account</a>
      </div>
    </nav>

    <nav>
      <div class="flex lg:hidden justify-between px-8 py-1 bg-gray-100 mb-5">
        <a href="/" class="hover:text-red-500">Products</a>
        <a href="/cart" class="hover:text-red-500">Cart</a>
        <a href="/user/account" class="text-red-500">My Account</a>
      </div>
    </nav>
    <div class="px-4 sm:px-6 lg:px-10 mb-20 overflow-x-hidden">

  <h2 class="text-xl sm:text-2xl font-bold mb-4">Account Center</h2>
  <div class="flex flex-col lg:flex-row gap-6 lg:justify-between h-full">
    <div class="bg-gray-100 border border-gray-200 px-4 py-4 flex flex-col gap-2 w-full lg:max-w-100 break-words">
      <div class="flex gap-3 items-center">
        <img src="<%=user.image%>" alt="" class="w-10 h-10 object-cover rounded-full">
        <h1 class="font-semibold text-lg sm:text-xl"><%= user.fullname %></h1>
      </div>
      <div class="bg-gray-200 h-[1px]"></div>
      <p class="text-sm sm:text-base"><span class="font-semibold">Email:</span> <%= user.email %></p>
      <div class="bg-gray-200 h-[1px]"></div>
      <p class="text-sm sm:text-base"><span class="font-semibold">Contact:</span> <%= user.contact %></p>
      <div class="bg-gray-200 h-[1px]"></div>
      <p class="text-sm sm:text-base break-words"><span class="font-semibold">Address:</span> <%= user.address %></p>
    </div>

    <div class="flex flex-col gap-4 w-full lg:w-auto">

      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/user/account/my-account" class="flex gap-4 items-center bg-gray-100 px-4 py-4 border border-gray-200 w-full lg:w-90">
          <i class="ri-user-5-fill text-3xl text-slate-600"></i>
          <div>
            <h3 class="font-semibold">Edit Account</h3>
            <p class="text-sm text-gray-600">Edit or Review Account Section</p>
          </div>
        </a>
        <a href="/user/account/my-orders" class="flex gap-4 items-center bg-gray-100 px-4 py-4 border border-gray-200 w-full lg:w-90">
          <i class="ri-box-2-fill text-3xl text-blue-600"></i>
          <div>
            <h3 class="font-semibold">My Orders</h3>
            <p class="text-sm text-gray-600">View order history</p>
          </div>
        </a>
      </div>

      <div class="flex flex-col sm:flex-row gap-4">
        <a href="" class="flex gap-4 items-center bg-gray-100 px-4 py-4 border border-gray-200 w-full lg:w-90">
          <i class="ri-mail-fill text-3xl text-indigo-500"></i>
          <div>
            <h3 class="font-semibold">Mail us</h3>
            <p class="text-sm text-gray-600">Reach out to us</p>
          </div>
        </a>
        <a href="/user/account/logout" class="flex gap-4 items-center bg-gray-100 px-4 py-4 border border-gray-200 w-full lg:w-90">
          <i class="ri-logout-circle-line text-3xl text-red-500"></i>
          <div>
            <h3 class="font-semibold">Logout</h3>
            <p class="text-sm text-gray-600">Logout from this account</p>
          </div>
        </a>
      </div>

    </div>
  </div>
</div>
</div>
<div class="footer flex-shrink-0 bg-gray-950 text-white flex flex-col lg:flex-row items-center lg:justify-between gap-6 lg:gap-0 px-4 sm:px-6 lg:px-15 py-7">
        <div class="left flex flex-col items-center lg:items-start gap-2">
            <img src="../images/ecom-logo-light.png" alt="Ecom Logo" class="w-40 sm:w-48 lg:w-[240px]"/>
            <h3 class="text-sm sm:text-base">Made by Rishav ❤️</h3>
        </div>


        <div class="right w-full lg:w-auto">
            <ul class="flex flex-wrap justify-center lg:justify-end gap-x-6 gap-y-2 text-sm sm:text-base">
                <li><a href="/" class="hover:underline">Products</a></li>
                <li><a href="/user/account" class="hover:underline">Account Center</a></li>
                <li><a href="/cart" class="hover:underline">My Cart</a></li>
                <li><a href="/user/account/my-orders" class="hover:underline">My Orders</a></li>
                <li><a href="/seller/register" class="hover:underline">Become a Seller</a></li>
                <li><a href="https://github.com/rishav2006" class="hover:underline">Github Page</a></li>
            </ul>
        </div>
    </div>
  </body>
</html>
