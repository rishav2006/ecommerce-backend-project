<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Account Center</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bangers&family=Figtree:ital,wght@0,300..900;1,300..900&family=Hachi+Maru+Pop&family=Manrope:wght@200..800&family=Metrophobic&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Questrial&family=Raleway:ital,wght@0,100..900;1,100..900&family=Red+Hat+Display:ital,wght@0,300..900;1,300..900&family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="../stylesheets/index.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@4.7.0/fonts/remixicon.css"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav class="flex justify-between lg:justify-between justify-center px-7 py-2 mb-0 lg:mb-7">
      <div class="logoPart">
        <img
          src="../images/ecom-logo.jpg"
          class="max-w-full h-auto"
          width="180"
        />
      </div>

      <div class="hidden lg:flex items-center gap-4">
        <a href="/" class="hover:text-red-500">Products</a>
        <a href="" class="hover:text-red-500">Cart</a>
        <a href="" class="text-red-500">My Account</a>
      </div>
    </nav>

    <nav>
      <div class="flex lg:hidden justify-between px-8 py-1 bg-gray-200 mb-5">
        <a href="/" class="hover:text-red-500">Products</a>
        <a href="" class="hover:text-red-500">Cart</a>
        <a href="" class="text-red-500">My Account</a>
      </div>
    </nav>
    <div class="px-10 mb-43">
        <h2 class="text-2xl font-bold mb-4">Account Center</h2>
        <div class="flex flex-wrap justify-between">
            <div class="left bg-gray-100 border-1 border-gray-200 px-5 py-3 flex flex-col gap-1 max-w-100 justify-center">
                <h1 class="font-semibold text-xl"><%=user.name%></h1>
                <div class="bg-gray-200 h-[1px]"></div>
                <h3>Email: <%=user.email%></h3>
                <div class="bg-gray-200 h-[1px]"></div>
                <h3>Joined: <%=user.date%></h3>
                <div class="bg-gray-200 h-[1px]"></div>
                <h3>Address: <%=user.address%></h3>
                <!-- <div class="bg-gray-200 h-[1px]"></div> -->
                <!-- <h3>Total Orders: <%=user.o%></h3> -->
            </div>
            <div class="right flex flex-col flex-wrap gap-3">
                <div class="flex gap-3">
                    <a href="" class="flex gap-4 items-center bg-gray-100 px-5 py-5 border-1 border-gray-200 w-90"><i class="ri-user-5-fill text-4xl text-slate-600"></i><div class="flex flex-col">
                        <h3 class="font-semibold">My Account</h3>
                        <h5 class="text-sm text-gray-600">Edit or Review Account Section</h5>
                    </div></a>
                    <a href="" class="flex gap-4 items-center bg-gray-100 px-5 py-5 border-1 border-gray-200 w-90"><i class="ri-box-2-fill text-4xl text-blue-600"></i><div class="flex flex-col">
                        <h3 class="font-semibold">My Orders</h3>
                        <h5 class="text-sm text-gray-600">View order history</h5>
                    </div></a>
                </div>
                <div class="flex gap-3">
                    <a href="" class="flex gap-4 items-center bg-gray-100 px-5 py-5 border-1 border-gray-200 w-90"><i class="ri-mail-fill text-4xl text-indigo-500"></i><div class="flex flex-col">
                        <h3 class="font-semibold">Mail us</h3>
                        <h5 class="text-sm text-gray-600">Reach out to us</h5>
                    </div></a>
                    <a href="" class="flex gap-4 items-center bg-gray-100 px-5 py-5 border-1 border-gray-200 w-90"><i class="ri-logout-circle-line text-4xl text-red-500"></i><div class="flex flex-col">
                        <h3 class="font-semibold">Logout</h3>
                        <h5 class="text-sm text-gray-600">Logout from this account</h5>
                    </div></a>
                </div>
            </div>
        </div>
    </div>
  </body>
</html>
