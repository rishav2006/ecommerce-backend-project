<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= product.name%> - Product Details</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bangers&family=Figtree:ital,wght@0,300..900;1,300..900&family=Hachi+Maru+Pop&family=Manrope:wght@200..800&family=Metrophobic&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Questrial&family=Raleway:ital,wght@0,100..900;1,100..900&family=Red+Hat+Display:ital,wght@0,300..900;1,300..900&family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="../stylesheets/index.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@4.7.0/fonts/remixicon.css"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav class="flex justify-between lg:justify-between justify-center px-7 py-2 mb-0 lg:mb-7">
      <div class="logoPart">
        <img
          src="/images/ecom-logo.png"
          class="max-w-full h-auto"
          width="180"
        />
      </div>

      <div class="hidden lg:flex items-center gap-4">
        <a href="/" class="hover:text-red-500">Products</a>
        <a href="/cart" class="hover:text-red-500">Cart</a>
        <a href="" class="hover:text-red-500">My Account</a>
      </div>
    </nav>

    <nav>
      <div class="flex lg:hidden justify-between px-8 py-1 bg-gray-100 mb-8">
        <a href="/" class="hover:text-red-500">Products</a>
        <a href="/cart" class="hover:text-red-500">Cart</a>
        <a href="" class="hover:text-red-500">My Account</a>
      </div>
    </nav>
    <div class="productDetails px-5">
      <div class="flex flex-wrap justify-evenly md:gap-16 lg:gap-32">
        <div class="left">
          <img src="<%= product.image %>" alt="" width="470px" />
        </div>
        <div class="right w-full lg:w-170 pt-17 flex flex-col gap-2">
          <a href="/" class="text-red-500"
            ><i class="ri-arrow-left-line"></i> Go back</a
          >
          <h2 class="text-2xl lg:text-4xl font-bold"><%=product.name%></h2>
          <h4 class="text-gray-700"><%=product.description%></h4>
          <h2 class="text-2xl font-semibold">$<%=product.price%></h2>
          <div class="flex flex-col sm:flex-row gap-3 mt-2">
            <a href="/orders/new/<%=product._id%>" class="bg-red-500 text-white px-10 lg:py-2 py-3 text-center active:scale-98">Buy Now</a>
            <a href="/cart/post/<%=product._id%>" class="bg-gray-200 border-1 border-gray-300 text-black px-10 lg:py-2 py-3 text-center active:scale-98" >Add to Cart</a>
          </div>
          <div class="w-full lg:w-170 h-[1px] bg-gray-300 my-5"></div>
          <div class="flex gap-7">
            <div>
              <i class="ri-verified-badge-fill text-emerald-600 text-3xl"></i>
              <h3 class="lg:text-md">Trusted Seller</h3>
            </div>
            <div>
              <i class="ri-star-smile-fill text-red-500 text-3xl"></i>
              <h3 class="lg:text-md">Best in Quality</h3>
            </div>
            <div>
              <i class="ri-reset-left-fill text-3xl"></i>
              <h3 class="lg:text-md">7 Days Return</h3>
            </div>
            <%if(product.ratings > 4){ %>
              <div>
                <i class="ri-star-fill text-yellow-500 text-3xl"></i>
                <h3 class="lg:text-md">Top Product</h3>
              </div>
            <% }%>
          </div>
        </div>
      </div>
      <div class="flex flex-wrap lg:justify-between mb-5 md:justify-evenly">
        <% if(product.seller){ %>
        <div class="flex flex-col justify-center px-5 py-7 bg-gray-100 border-1 border-gray-300 mt-15 w-230">
          <h2 class="text-xl font-semibold mb-1">About the Seller</h2>
          <h3 class="text-3xl font-bold mb-2"><%= product.seller.name %></h3>
          <h4 class="text-gray-900 font-semibold text-lg mb-1">
            Contact Details
          </h4>
          <div class="flex gap-2">
            <i class="ri-mail-fill text-red-500"></i>
            <h4>Email: <%= product.seller.email %></h4>
          </div>
          <div class="flex gap-2">
            <i class="ri-phone-fill text-red-500"></i>
            <h4>Contact: <%= product.seller.contact %></h4>
          </div>
          <div class="flex gap-2">
            <i class="ri-map-pin-fill text-red-500"></i>
            <h4>Address: <%= product.seller.address %></h4>
          </div>
          <div class="flex gap-2">
            <i class="ri-contacts-book-3-line text-red-500"></i>
            <h4>GSTIN Number: <%= product.seller.gstin %></h4>
          </div>
        </div>
        <% } %>
        <div
          class="flex flex-col justify-center px-5 py-7 bg-gray-100 border-1 border-gray-300 mt-15 w-100"
        >
          <h2 class="text-xl font-semibold mb-1 text-center">
            Product Ratings
          </h2>
          <div class="flex justify-center items-center gap-3">
            <i class="ri-star-fill text-5xl text-yellow-500"></i>
            <h2 class="text-5xl"><%=product.ratings%></h2>
          </div>
          <% if(product.ratings == 0){ %>
          <h2 class="text-center mt-2">
            No ratings yet! Purchase one to give ratings.
          </h2>
          <% } %>
        </div>
      </div>
    </div>
    <div class="footer bg-gray-950 text-white flex flex-col lg:flex-row items-center lg:justify-between gap-6 lg:gap-0 px-4 sm:px-6 lg:px-15 py-7">
        <div class="left flex flex-col items-center lg:items-start gap-2">
            <img src="../images/ecom-logo-light.png" alt="Ecom Logo" class="w-40 sm:w-48 lg:w-[240px]"/>
            <h3 class="text-sm sm:text-base">Made by Rishav ❤️</h3>
        </div>


        <div class="right w-full lg:w-auto">
            <ul class="flex flex-wrap justify-center lg:justify-end gap-x-6 gap-y-2 text-sm sm:text-base">
                <li><a href="/" class="hover:underline">Products</a></li>
                <li><a href="/user/account" class="hover:underline">Account Center</a></li>
                <li><a href="/cart" class="hover:underline">My Cart</a></li>
                <li><a href="/user/account/my-orders" class="hover:underline">My Orders</a></li>
                <li><a href="/seller/register" class="hover:underline">Become a Seller</a></li>
                <li><a href="https://github.com/rishav2006" class="hover:underline">Github Page</a></li>
            </ul>
        </div>
    </div>
  </body>
</html>
