<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= product.name%> - Checkout</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bangers&family=Figtree:ital,wght@0,300..900;1,300..900&family=Hachi+Maru+Pop&family=Manrope:wght@200..800&family=Metrophobic&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Questrial&family=Raleway:ital,wght@0,100..900;1,100..900&family=Red+Hat+Display:ital,wght@0,300..900;1,300..900&family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="../stylesheets/index.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@4.7.0/fonts/remixicon.css"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav class="flex justify-between px-7 py-2 mb-7">
      <div class="logoPart">
        <img src="../images/ecom-logo.jpg" alt="" width="180px" />
      </div>
      <div class="lists flex items-center gap-4">
        <ul>
          <a href="/" class="hover:text-red-500">Products</a>
        </ul>
        <ul>
          <a href="" class="hover:text-red-500">Cart</a>
        </ul>
        <ul>
          <a href="" class="hover:text-red-500">My Account</a>
        </ul>
      </div>
    </nav>
    <div class="pl-10 pr-20 py-5">
        <a href="/products/<%=product._id%>" class="text-red-500"
            ><i class="ri-arrow-left-line"></i> Go back</a
          >
      <h2 class="text-2xl font-semibold mb-4">Review your Order</h2>
      <form action="/orders/new/<%=product._id%>" method="post">
        <div class="flex justify-between">
          <div class="left">
            <div class="item flex items-center bg-gray-100 w-105 p-3">
              <img
                src="<%=product.image%>"
                alt=""
                width="140px"
              />
              <div class="flex flex-col text-xl ml-4">
                <h4 class="font-semibold"><%=product.name%></h4>
                <h4>$<%=product.price%></h4>
                <h5 class="text-sm text-gray-700">Sold by: <%=product.seller.name%></h5>
                <h5 class="text-sm text-gray-700">Qty: 1</h5>
              </div>
            </div>
            <h4 class="text-center pt-2 text-gray-700">No more items</h4>
          </div>
          <div class="right flex flex-col gap-3">
            
            <div class="address flex flex-col gap-2">
              <h2 class="text-2xl font-semibold">Address Details</h2>
              <input
                type="text"
                placeholder="Enter Complete Address"
                name="address"
                class="w-120 px-3 py-2 bg-gray-100 border-1 border-gray-300 outline-none"
              />
              <input
                type="text"
                placeholder="Pincode"
                name="pincode"
                class="w-120 px-3 py-2 bg-gray-100 border-1 border-gray-300 outline-none"
              />
            </div>
            <div class="payment flex flex-col gap-2">
              <h4 class="text-2xl font-semibold">Choose Payment Method</h4>
              <div class="flex gap-2 mb-2">
                <input type="radio" name="POD" id="" value="Pay on Delivery" />
                <label for="html">Pay On Delivery</label>
              </div>
              <input
                type="submit"
                value="Place Order"
                class="cursor-pointer w-120 px-3 py-2 bg-red-500 text-white"
              />
            </div>
          </div>
        </div>
      </form>
    </div>
  </body>
</html>
