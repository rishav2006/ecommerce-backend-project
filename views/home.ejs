<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bangers&family=Figtree:ital,wght@0,300..900;1,300..900&family=Hachi+Maru+Pop&family=Manrope:wght@200..800&family=Metrophobic&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Questrial&family=Raleway:ital,wght@0,100..900;1,100..900&family=Red+Hat+Display:ital,wght@0,300..900;1,300..900&family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../stylesheets/index.css">
<link
    href="https://cdn.jsdelivr.net/npm/remixicon@4.7.0/fonts/remixicon.css"
    rel="stylesheet"
/>
</head>
<body>
    <nav class="flex justify-between lg:justify-between justify-center px-7 py-2 mb-0">
      <div class="logoPart">
        <img
          src="/images/ecom-logo.jpg"
          class="max-w-full h-auto"
          width="180"
        />
      </div>

      <div class="hidden lg:flex items-center gap-4">
        <a href="/" class="text-red-500">Products</a>
        <a href="/cart" class="hover:text-red-500">Cart</a>
        <a href="/user/account" class="hover:text-red-500">My Account</a>
      </div>
    </nav>

    <nav>
      <div class="flex lg:hidden justify-between px-8 py-1 bg-gray-100 mb-0 border-b-1 border-gray-300">
        <a href="/" class="text-red-500">Products</a>
        <a href="/cart" class="hover:text-red-500">Cart</a>
        <a href="/user/account" class="hover:text-red-500">My Account</a>
      </div>
    </nav>
    <div class="hero h-90 bg-gray-50 lg:bg-gray-100  flex flex-col items-center gap-4 px-4 sm:px-0">
        <div class="textBig pt-10 sm:pt-15 flex flex-col items-center gap-3">
            <h2 class="text-6xl sm:text-4xl md:text-5xl lg:text-7xl text-center font-medium leading-tight">THE BIGGEST SALE <br class="hidden sm:block" />OF THE YEAR IS BACK!</h2>
            <p class="tracking-wider bg-red-600 px-4 py-1 text-white text-sm sm:text-base rounded-tr-2xl rounded-bl-2xl">SALE STARTS 29th FEB</p>
        </div>
  <!-- `     <a href="" class="bg-gray-950 text-white px-6 py-3 sm:px-4 sm:py-2 rounded-full text-sm sm:text-base">View Products</a> -->
    </div>

    <div class="p-10">
        <h2 class="font-bold text-2xl text-center mb-3">PRODUCTS SPACE</h2>
        <div class="cards flex flex-wrap gap-4">
            <% products.forEach(function(val){ %>
            <a href="products/<%=val._id%>">
                <div class="card w-50 bg-gray-100 p-3 flex flex-col">
                <img src=<%=val.image%> alt="">
                <% if(val.ratings > 4){ %>
                    <h4 class="bg-red-500 text-white text-[12px] flex items-center gap-1 px-1 py-0.5"><i class="ri-star-smile-fill"></i>Top Product</h4>
                <% } else { %>
                    <div class="mt-[21px]"></div>
                <% } %>
                <h3 class="font-bold"><%=val.name%></h3>
                <p>$<%=val.price%></p>
                <!-- <a href="products/<%=val._id%>" class="text-white bg-gray-950 text-center py-1 active:scale-98">View Details</a> -->
                </div>
            </a>
            <% }) %>
            
        </div>
    </div>
    <div class="footer bg-gray-950 text-white flex flex-col lg:flex-row items-center lg:justify-between gap-6 lg:gap-0 px-4 sm:px-6 lg:px-15 py-7">
        <div class="left flex flex-col items-center lg:items-start gap-2">
            <img src="../images/ecom-logo.jpg" alt="Ecom Logo" class="w-40 sm:w-48 lg:w-[240px]"/>
            <h3 class="text-sm sm:text-base">Made by Rishav ❤️</h3>
        </div>


        <div class="right w-full lg:w-auto">
            <ul class="flex flex-wrap justify-center lg:justify-end gap-x-6 gap-y-2 text-sm sm:text-base">
                <li><a href="" class="hover:underline">Products</a></li>
                <li><a href="" class="hover:underline">Account Center</a></li>
                <li><a href="" class="hover:underline">My Cart</a></li>
                <li><a href="" class="hover:underline">My Orders</a></li>
                <li><a href="" class="hover:underline">Become a Seller</a></li>
                <li><a href="" class="hover:underline">Github Page</a></li>
            </ul>
        </div>
    </div>

</body>
</html>