<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bangers&family=Figtree:ital,wght@0,300..900;1,300..900&family=Hachi+Maru+Pop&family=Manrope:wght@200..800&family=Metrophobic&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Questrial&family=Raleway:ital,wght@0,100..900;1,100..900&family=Red+Hat+Display:ital,wght@0,300..900;1,300..900&family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../stylesheets/index.css">
<link
    href="https://cdn.jsdelivr.net/npm/remixicon@4.7.0/fonts/remixicon.css"
    rel="stylesheet"
/>
</head>
<body>
    <nav class="flex justify-between px-7 py-2">
        <div class="logoPart">
            <img src="../images/ecom-logo.jpg" alt="" width="180px">
        </div>
        <div class="lists flex items-center gap-4">
            <ul><a href="/">Products</a></ul>
            <ul><a href="">Cart</a></ul>
            <ul><a href="">My Account</a></ul>
        </div>
    </nav>
    <div class="hero h-90 bg-gray-100 flex flex-col items-center gap-2">
        <div class="textBig pt-15 flex flex-col items-center gap-1">
            <h2 class="text-7xl text-center">THE BIGGEST SALE <br> OF THE YEAR IS BACK!</h2>
            <p class="tracking-wider bg-red-600 px-4 py-1 text-white rounded-tr-2xl rounded-bl-2xl">SALE STARTS 29th FEB</p>
        </div>
        <a href="" class="bg-gray-950 text-white px-4 py-2 rounded-full">View Products</a>
    </div>
    <div class="p-10">
        <h2 class="font-bold text-2xl text-center mb-3">PRODUCTS SPACE</h2>
        <div class="cards flex flex-wrap gap-4">
            <% products.forEach(function(val){ %>
            <div class="card w-50 bg-gray-100 p-3 flex flex-col">
                <img src=<%=val.image%> alt="">
                <% if(val.ratings > 4){ %>
                    <h4 class="bg-red-500 text-white text-[12px] flex items-center gap-1 px-1 py-0.5"><i class="ri-star-smile-fill"></i>High-ratings</h4>
                <% } else { %>
                    <div class="mt-[21px]"></div>
                <% } %>
                <h3 class="font-bold"><%=val.name%></h3>
                <p>$<%=val.price%></p>
                <a href="products/<%=val._id%>" class="text-white bg-gray-950 text-center py-1 active:scale-98">View Details</a>
            </div>
            <% }) %>
        </div>
    </div>
    <div class="footer h-30 bg-gray-950 flex justify-between text-white">
        <div class="left flex flex-col justify-center pl-15">
            <img src="../images/ecom-logo.jpg" alt="" width="240px">
            <h3>Made by Rishav ❤️</h3>
        </div>
        <div class="right text-white flex items-center pr-15 gap-3">
            <!-- <h3 class="font-semibold text-xl">Quick Links</h3> -->
            <ul><a href="">Products</a></ul>
            <ul><a href="">Account Center</a></ul>
            <ul><a href="">My Cart</a></ul>
            <ul><a href="">My Orders</a></ul>
            <ul><a href="">Become a Seller</a></ul>
            <ul><a href="">Github Page</a></ul>
        </div>
    </div>
</body>
</html>