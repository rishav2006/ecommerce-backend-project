<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seller Home | All Products</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Bangers&family=Figtree:ital,wght@0,300..900;1,300..900&family=Hachi+Maru+Pop&family=Manrope:wght@200..800&family=Metrophobic&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Questrial&family=Raleway:ital,wght@0,100..900;1,100..900&family=Red+Hat+Display:ital,wght@0,300..900;1,300..900&family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/index.css" />
</head>
<body>
    <div class="min-h-screen ">
    <nav class="flex justify-between lg:justify-between justify-center px-7 py-2 mb-0">
      <div class="logoPart">
        <img
          src="/images/ecom-logo.jpg"
          class="max-w-full h-auto"
          width="180"
        />
      </div>

      <div class="hidden lg:flex items-center gap-4">
        <a href="/seller/admin/view-orders" class="text-indigo-600">View Orders</a>
        <a href="/seller/admin" class="text-indigo-600">View Added Products</a>
        <a href="/seller/admin/add" class="bg-indigo-600 text-white px-4 py-2">Add Products</a>
        <a href="/seller/logout" class="text-red-500">Logout</a>
      </div>
    </nav>

    <nav>
      <div class="flex lg:hidden justify-between px-8 py-1 bg-gray-100 mb-0 border-b-1 border-gray-300">
        <a href="/seller/admin/view-orders" class="text-indigo-600">Orders</a>
        <a href="/seller/admin" class="text-indigo-600">Your Products</a>
        <a href="/seller/admin/add" class="bg-indigo-600 text-white px-3">Add</a>
        <a href="/seller/logout" class="text-red-500">Logout</a>
      </div>
    </nav>
        <div class="px-7 lg:px-10 py-5 flex flex-col gap-5 lg:gap-9">
            <h2 class="text-2xl font-semibold">All Products</h2>
            <div class="flex flex-wrap gap-3 lg:gap-5 justify-between lg:justify-start mb-7 lg:mb-0">
                <% products.reverse().forEach(function(val){ %>
                    <div class="card bg-zinc-200 p-3 flex flex-col flex-wrap w-40 lg:w-55">
                        <div class="flex flex-col items-center mb-2">
                            <img src=<%=val.image%> alt="" class="h-30 w-25 lg:h-60 lg:w-50 object-cover">
                            <div class="flex flex-col">
                              <h2 class="text-lg lg:text-xl font-medium"><%=val.name%></h2>
                              <h3 class="font-black text-md lg:text-lg">$<%=val.price%></h3>
                            </div>
                        </div>
                        <a href="/seller/admin/edit/<%=val._id%>" class="bg-gray-900 text-white flex justify-center p-2">Edit this</a>
                    </div>
                <% }) %>
            </div>
        </div>
        
    </div>
</body>
</html>