<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seller Home | All Products</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Bangers&family=Figtree:ital,wght@0,300..900;1,300..900&family=Hachi+Maru+Pop&family=Manrope:wght@200..800&family=Metrophobic&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Questrial&family=Raleway:ital,wght@0,100..900;1,100..900&family=Red+Hat+Display:ital,wght@0,300..900;1,300..900&family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/index.css" />
</head>
<body>
    <div class="min-h-screen ">
        <div class="flex items-center justify-between py-3 px-7 mb-1">
            <img src="../images/ecom-logo.jpg" alt="" width="160px">
            <div class="flex gap-7">
                <ul><a href="/seller/admin/view-orders" class="text-teal-800">View Orders</a></ul>
                <ul><a href="" class="text-teal-800">View Added Products</a></ul>
                <ul><a href="/seller/admin/add" class="bg-teal-900 px-4 py-2 text-white">Add Products</a></ul>
                <ul><a href="/seller/logout" class="text-red-700">Logout</a></ul>
            </div>
        </div>
        <div class="px-10 py-5 flex flex-col gap-9">
            <h2 class="text-2xl font-semibold">All Products</h2>
            <div class="flex flex-wrap gap-3">
                <% products.reverse().forEach(function(val){ %>
                    <div class="card bg-zinc-200 p-3 flex flex-col flex-wrap w-55">
                        <div class="flex flex-col mb-2">
                            <img src=<%=val.image%> alt="" class="h-60 w-50 object-cover">
                            <h2 class="text-xl font-medium"><%=val.name%></h2>
                            <h3 class="font-black text-lg">$<%=val.price%></h3>
                        </div>
                        <a href="/seller/admin/edit/<%=val._id%>" class="bg-gray-900 text-white flex justify-center p-2">Edit this</a>
                    </div>
                <% }) %>
            </div>
        </div>
        
    </div>
</body>
</html>