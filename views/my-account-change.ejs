<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Account Details</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bangers&family=Figtree:ital,wght@0,300..900;1,300..900&family=Hachi+Maru+Pop&family=Manrope:wght@200..800&family=Metrophobic&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Questrial&family=Raleway:ital,wght@0,100..900;1,100..900&family=Red+Hat+Display:ital,wght@0,300..900;1,300..900&family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/index.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@4.7.0/fonts/remixicon.css"
      rel="stylesheet"
    />
</head>
<body>
    <nav class="flex justify-between lg:justify-between justify-center px-7 py-2 mb-0 lg:mb-7">
      <div class="logoPart">
        <img
          src="/images/ecom-logo.png"
          class="max-w-full h-auto"
          width="180"
        />
      </div>

      <div class="hidden lg:flex items-center gap-4">
        <a href="/" class="hover:text-red-500">Products</a>
        <a href="/cart" class="hover:text-red-500">Cart</a>
        <a href="/user/account" class="text-red-500">My Account</a>
      </div>
    </nav>

    <nav>
      <div class="flex lg:hidden justify-between px-8 py-1 bg-gray-100 mb-5">
        <a href="/" class="hover:text-red-500">Products</a>
        <a href="/cart" class="hover:text-red-500">Cart</a>
        <a href="/user/account" class="text-red-500">My Account</a>
      </div>
    </nav>

    <div class="px-7 lg:px-10 py-5 flex flex-col gap-4 lg:gap-6">
            <h2 class="text-2xl font-semibold">Edit Details</h2>
            <form action="/user/account/my-account" method="post">
                <div class="flex flex-col gap-2">
                    <input type="text" class="w-full lg:w-100 bg-gray-200 px-3 py-2 outline-none" placeholder="Name" name="name" value="<%=user.fullname%>">
                    <input type="text" class="w-full lg:w-100 bg-gray-200 px-3 py-2 outline-none" placeholder="Email" name="email" value="<%=user.email%>">
                    <input type="text" class="w-full lg:w-100 bg-gray-200 px-3 py-2 outline-none" placeholder="Contact" name="contact" value="<%=user.contact%>">
                    <input type="text" class="w-full lg:w-100 bg-gray-200 px-3 py-2 outline-none" placeholder="Address" name="address" value="<%=user.address%>">
                    <input type="text" class="w-full lg:w-100 bg-gray-200 px-3 py-2 outline-none" placeholder="Image URL" name="image" value="<%=user.image%>">
                    <input type="submit" class="w-100 px-3 py-2 bg-red-500 text-white w-full lg:w-100 cursor-pointer" value="Confirm Changes">
                </div>
            </form>
    </div>
</body>
</html>