<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="min-h-screen ">
        <div class="flex items-center justify-center p-3 mb-30">
            <img src="../images/ecom-logo.jpg" alt="" width="160px">
        </div>
        <form action="/user/login" method="post" class="flex flex-col justify-center items-center">
            <h2 class="text-2xl font-semibold mb-4">Login</h2>
            <div class="flex flex-col w-70 gap-2">
                <input type="email" placeholder="Email address" class="p-2 outline-none bg-zinc-200" name="email">
                <input type="password" placeholder="Password" class="p-2 outline-none bg-zinc-200" name="password">
                <input type="submit" value="Login" class="bg-gray-950 text-white p-2 cursor-pointer active:scale-98">
                <h3 class="text-center">Don't have an account ? <span class="text-indigo-600"><a href="./signup">Create One</a></span></h3>
            </div>
        </form>
    </div>
</body>
</html>